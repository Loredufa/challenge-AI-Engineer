# DocuMind AI — Backend Environment Variables
# Copy: cp .env.example .env

NODE_ENV=development
PORT=8080

# Database
DATABASE_URL=postgres://dev:dev@localhost:5432/documind

# Redis
REDIS_URL=redis://localhost:6379



# JWT RS256 — generate with:
# node -e "const {generateKeyPairSync}=require('crypto');const {privateKey,publicKey}=generateKeyPairSync('rsa',{modulusLength:2048});console.log('PRIV:',privateKey.export({type:'pkcs8',format:'pem'}).toString())"
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# OpenAI & Endebbing LLMs (uncomment the provider you want to use and fill in the API key)
#LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-wv__O...
#LLM_MODEL=gpt-4o


# Claude
#LLM_PROVIDER=anthropic
#LLM_MODEL=claude-sonnet-4-6
#LLM_API_KEY=sk-ant-ap...

# DeepSeek
LLM_PROVIDER=openai-compatible
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-d85ab...

# Groq
#LLM_PROVIDER=openai-compatible
#LLM_MODEL=llama-3.1-70b-versatile
#LLM_BASE_URL=https://api.groq.com/openai/v1
#LLM_API_KEY=gsk_...

# Gemini
#LLM_PROVIDER=openai-compatible
#LLM_MODEL=gemini-2.0-flash
#LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#LLM_API_KEY=AIza...   # tu Google AI Studio API key


# AWS (required for S3/SES in production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Storage (documind-local = stores in /tmp for dev)
S3_BUCKET=documind-local

# Email (console = print OTP to stdout in dev)
EMAIL_PROVIDER=console

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
